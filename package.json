{
  "name": "foxy-harness",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "foxy-harness": "src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/cli.ts",
    "login": "bun src/cli.ts login",
    "models": "bun src/cli.ts models",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/foxy-harness",
    "debug": "bun --inspect-wait=localhost:6499/foxy-harness src/cli.ts",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "lint": "oxlint --tsconfig tsconfig.json",
    "lint:fix": "oxlint --tsconfig tsconfig.json --fix"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "^5.9.0"
  }
}
